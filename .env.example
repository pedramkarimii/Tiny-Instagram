DEBUG=true
SECURE_SSL_REDIRECT=true
ENABLE_ERROR_REDIRECT_MIDDLEWARE=false
SECRET_KEY=django-insecure-local-development-only-change-me
TIME_ZONE=Asia/Tehran
DOMAIN_NAME=localhost
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

DB_NAME=tiny_instagram
DB_USER=tiny_instagram
DB_PASSWORD=change-me-local-only
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

API_LOG_LEVEL=info
API_WORKERS=2
API_THREADS=2

NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_HOST_PORT=8081
NGINX_HTTPS_HOST_PORT=8444

LOG_FILE_PATH=/tmp/tiny-instagram.log
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

AWS_ACCESS_KEY_ID=unused-local
AWS_SECRET_ACCESS_KEY=unused-local
AWS_S3_ENDPOINT_URL=https://s3.example.com
AWS_STORAGE_BUCKET_NAME=unused-local
AWS_S3_FILE_OVERWRITE=false
AWS_SERVICE_NAME=s3

DEBUG_DEFAULT_FROM_EMAIL=dev@example.com
DEBUG_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEBUG_EMAIL_HOST=localhost
DEBUG_EMAIL_HOST_USER=
DEBUG_EMAIL_HOST_PASSWORD=
DEBUG_EMAIL_PORT=1025
DEBUG_EMAIL_USE_SSL=false
DEBUG_EMAIL_USE_TLS=false

DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_PORT=587
EMAIL_USE_SSL=false
EMAIL_USE_TLS=true
